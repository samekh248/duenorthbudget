<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer. The secret store's key lives in the keystore, which never moves with a backup. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="due-north-secrets.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="due-north-secrets.xml" />
    </device-transfer>
</data-extraction-rules>
