<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and older. Nothing is backed up, so a reinstall starts clean. allowBackup="false" already turns
     backup off; these excludes keep it off if that flag is ever flipped back. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
