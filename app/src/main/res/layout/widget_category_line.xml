<?xml version="1.0" encoding="utf-8"?>
<!-- One category in a widget one cell tall and narrow: the name and its whole balance on a single line. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/row"
    android:layout_width="match_parent"
    android:layout_height="22dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/row_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:fontFamily="@font/selawik_regular"
        android:maxLines="1"
        android:textColor="@color/widget_foreground"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/row_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="6dp"
        android:includeFontPadding="false"
        android:fontFamily="@font/selawik_regular"
        android:maxLines="1"
        android:textColor="@color/widget_foreground"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/row_amount_over"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:background="@drawable/widget_pill_error"
        android:paddingHorizontal="9dp"
        android:paddingVertical="1dp"
        android:includeFontPadding="false"
        android:fontFamily="@font/selawik_semibold"
        android:maxLines="1"
        android:textColor="@color/widget_on_error_container"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
