<?xml version="1.0" encoding="utf-8"?>
<!-- The category balance widget, design B+ (the ledger list, half Metro and half Material 3). CategoryWidget fills it for the widget's size. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_surface"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp">

    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:letterSpacing="0.06"
            android:includeFontPadding="false"
            android:fontFamily="@font/selawik_semibold"
            android:maxLines="1"
            android:textColor="@color/widget_secondary"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/widget_days"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_chip"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:includeFontPadding="false"
            android:fontFamily="@font/selawik_semibold"
            android:maxLines="1"
            android:textColor="@color/widget_on_chip"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_heads"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingBottom="3dp"
        android:paddingHorizontal="12dp"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="58dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="budgeted"
            android:includeFontPadding="false"
            android:fontFamily="@font/selawik_regular"
            android:maxLines="1"
            android:textColor="@color/widget_secondary"
            android:textSize="10sp" />

        <TextView
            android:layout_width="58dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="spent"
            android:includeFontPadding="false"
            android:fontFamily="@font/selawik_regular"
            android:maxLines="1"
            android:textColor="@color/widget_secondary"
            android:textSize="10sp" />

        <TextView
            android:layout_width="88dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="left"
            android:includeFontPadding="false"
            android:fontFamily="@font/selawik_regular"
            android:maxLines="1"
            android:textColor="@color/widget_secondary"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- The list's rows, on a rounded card. -->
    <LinearLayout
        android:id="@+id/widget_rows"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/widget_card"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="2dp" />

    <!-- One cell tall and narrow: bare lines, no card. -->
    <LinearLayout
        android:id="@+id/widget_lines"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/widget_strip"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="-4dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:includeFontPadding="false"
        android:fontFamily="@font/selawik_regular"
        android:gravity="center"
        android:textColor="@color/widget_secondary"
        android:textSize="14sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/widget_footer"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/widget_chip"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="5dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_total_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:includeFontPadding="false"
            android:fontFamily="@font/selawik_regular"
            android:maxLines="1"
            android:textColor="@color/widget_on_chip"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/widget_total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_pill_surface"
            android:paddingHorizontal="14dp"
            android:paddingVertical="2dp"
            android:includeFontPadding="false"
            android:fontFamily="@font/selawik_semibold"
            android:maxLines="1"
            android:textColor="@color/widget_foreground"
            android:textSize="19sp" />

        <TextView
            android:id="@+id/widget_total_over"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_pill_error"
            android:paddingHorizontal="14dp"
            android:paddingVertical="2dp"
            android:includeFontPadding="false"
            android:fontFamily="@font/selawik_semibold"
            android:maxLines="1"
            android:textColor="@color/widget_on_error_container"
            android:textSize="19sp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
