<?xml version="1.0" encoding="utf-8"?>
<!-- The widget picker's preview of the category balance widget, with sample categories. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_surface"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:includeFontPadding="false"
            android:fontFamily="@font/selawik_semibold"
            android:letterSpacing="0.06"
            android:text="THIS MONTH"
            android:textColor="@color/widget_secondary"
            android:textSize="11sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_chip"
            android:includeFontPadding="false"
            android:fontFamily="@font/selawik_semibold"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:text="12 days left"
            android:textColor="@color/widget_on_chip"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_card"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:includeFontPadding="false"
                android:fontFamily="@font/selawik_regular"
                android:text="groceries"
                android:textColor="@color/widget_foreground"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:fontFamily="@font/selawik_semilight"
                android:text="$212.40"
                android:textColor="@color/widget_foreground"
                android:textSize="16sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/widget_track" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:includeFontPadding="false"
                android:fontFamily="@font/selawik_regular"
                android:text="dining out"
                android:textColor="@color/widget_foreground"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_pill_error"
                android:includeFontPadding="false"
                android:fontFamily="@font/selawik_semibold"
                android:paddingHorizontal="9dp"
                android:paddingVertical="1dp"
                android:text="-$18.25"
                android:textColor="@color/widget_on_error_container"
                android:textSize="14sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/widget_track" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:includeFontPadding="false"
                android:fontFamily="@font/selawik_regular"
                android:text="gas"
                android:textColor="@color/widget_foreground"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:fontFamily="@font/selawik_semilight"
                android:text="$96.00"
                android:textColor="@color/widget_foreground"
                android:textSize="16sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/widget_track" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:includeFontPadding="false"
                android:fontFamily="@font/selawik_regular"
                android:text="household"
                android:textColor="@color/widget_foreground"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:fontFamily="@font/selawik_semilight"
                android:text="$130.10"
                android:textColor="@color/widget_foreground"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
